---
interface Props {
  title: string;
  lastUpdate?: string;
  commitSha?: string;
}

const { title, lastUpdate, commitSha } = Astro.props;
---

<header>
  <h1>{title}</h1>
  {
    lastUpdate && (
      <p class="last-update">
        Le immagini sono state aggiornate alla data:
        <br />
        <strong>{lastUpdate}</strong>
        {commitSha && <span class="commit-sha"> ({commitSha})</span>}
      </p>
    )
  }
</header>

<style>
  header {
    background-color: #2c3e50;
    color: white;
    padding: 2rem;
    text-align: center;
  }

  header h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
  }

  .last-update {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .commit-sha {
    font-family: monospace;
    font-size: 0.8rem;
    opacity: 0.7;
  }

  @media (max-width: 600px) {
    header {
      padding: 1.5rem 1rem;
    }

    header h1 {
      font-size: 1.5rem;
    }

    .last-update {
      font-size: 0.8rem;
    }
  }
</style>
