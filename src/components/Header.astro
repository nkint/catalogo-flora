---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header>
  <h1>{title}</h1>
</header>

<style>
  header {
    background-color: #2c3e50;
    color: white;
    padding: 2rem;
    text-align: center;
  }

  header h1 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0;
  }

  @media (max-width: 600px) {
    header {
      padding: 1.5rem 1rem;
    }

    header h1 {
      font-size: 1.5rem;
    }
  }
</style>
