---
import type { Product } from '../lib/products';

interface Props {
  product: Product;
  baseUrl: string;
}

const { product, baseUrl } = Astro.props;
---

<article class="product-row">
  <img
    src={product.image}
    alt={product.name}
    class="product-image"
    loading="lazy"
    onerror={`this.onerror=null; this.src='${baseUrl}/images/default.svg'`}
    role="button"
    tabindex="0"
  />

  <div class="product-info">
    <h2 class="product-name">{product.name}</h2>
    <p class="product-code">Codice: {product.code}</p>

    <div class="product-details">
      {
        product.potSize && (
          <span class="product-detail">Vaso: {product.potSize}</span>
        )
      }
      {
        product.numPerBox && (
          <span class="product-detail">N. per cassa: {product.numPerBox}</span>
        )
      }
      {
        product.numPerPlane && (
          <span class="product-detail">
            N. per piano: {product.numPerPlane}
          </span>
        )
      }
      {product.daGiardino && <span class="product-tag">Da giardino</span>}
      {product.daGarden && <span class="product-tag">Da garden</span>}
    </div>

    {product.note && <p class="product-note">{product.note}</p>}
  </div>

  <div class="product-prices">
    {
      product.pricePerPiece && (
        <p class="product-price">{product.pricePerPiece} €/pz</p>
      )
    }
    {
      product.pricePerBox && (
        <p class="product-price-box">{product.pricePerBox} €/cc</p>
      )
    }
  </div>

  <button
    class="info-button"
    data-raw={JSON.stringify(product.raw)}
    aria-label={`Dettagli di ${product.name}`}
  >
    <img src={`${baseUrl}/code-icon.svg`} alt="Info" class="info-icon" />
  </button>
</article>

<style>
  .product-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: white;
    padding: 1rem 1.5rem;
    transition: background-color 0.2s ease;
    border-bottom: 1px solid #eee;
  }

  .product-row:last-child {
    border-bottom: none;
  }

  .product-row:hover {
    background-color: #f8f9fa;
  }

  .product-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
    flex-shrink: 0;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .product-image:hover {
    transform: scale(1.05);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .product-info {
    flex: 1;
    min-width: 0;
  }

  .product-name {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    color: #2c3e50;
  }

  .product-code {
    font-size: 0.8rem;
    color: #666;
    margin: 0 0 0.25rem 0;
  }

  .product-prices {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 0.25rem;
  }

  .product-price {
    font-size: 1.125rem;
    font-weight: 700;
    color: #27ae60;
    margin: 0;
  }

  .product-price-box {
    font-size: 0.9rem;
    font-weight: 600;
    color: #2980b9;
    margin: 0;
  }

  .product-note {
    font-size: 0.8rem;
    color: #777;
    font-style: italic;
    margin: 0;
  }

  .product-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0.5rem 0;
  }

  .product-detail {
    font-size: 0.8rem;
    color: #555;
    background: #f0f0f0;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .product-tag {
    font-size: 0.75rem;
    color: white;
    background: #27ae60;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .info-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    opacity: 0.6;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }

  .info-button:hover {
    opacity: 1;
  }

  .info-icon {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 600px) {
    .product-row {
      display: grid;
      grid-template-columns: 60px 1fr auto;
      grid-template-rows: auto auto;
      grid-template-areas:
        'image info prices'
        'image details details';
      gap: 0.5rem 0.75rem;
      padding: 0.75rem 1rem;
      align-items: start;
    }

    .product-image {
      grid-area: image;
      width: 60px;
      height: 60px;
    }

    .product-info {
      grid-area: info;
    }

    .product-name {
      font-size: 1rem;
      margin: 0;
    }

    .product-code {
      font-size: 0.75rem;
      margin: 0;
    }

    .product-details {
      grid-area: details;
      margin: 0;
      gap: 0.35rem;
    }

    .product-detail {
      font-size: 0.7rem;
      padding: 0.15rem 0.4rem;
      white-space: nowrap;
    }

    .product-tag {
      font-size: 0.65rem;
      padding: 0.15rem 0.4rem;
    }

    .product-prices {
      grid-area: prices;
      align-items: flex-end;
    }

    .product-price {
      font-size: 1rem;
    }

    .product-price-box {
      font-size: 0.8rem;
    }

    .info-button {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      padding: 0.25rem;
    }

    .info-icon {
      width: 20px;
      height: 20px;
    }

    .product-row {
      position: relative;
    }

    .product-note {
      font-size: 0.7rem;
      margin-top: 0.25rem;
    }
  }
</style>
