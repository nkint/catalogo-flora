---
/**
 * Password Page
 * Saves GitHub token to localStorage for mobile image upload authentication.
 */

import Header from '../components/Header.astro';
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Token GitHub - Catalogo Flora</title>
  </head>

  <body>
    <Header title="Configurazione Token" />

    <main>
      <div class="token-form">
        <h2>Inserisci il Token GitHub</h2>
        <p class="description">
          Questo token viene salvato localmente sul dispositivo e serve per
          caricare le foto nel repository.
        </p>

        <div class="input-group">
          <label for="tokenInput">Token GitHub</label>
          <input
            type="password"
            id="tokenInput"
            placeholder="ghp_xxxxxxxxxxxx"
            autocomplete="off"
          />
        </div>

        <button id="saveBtn" type="button">Salva</button>

        <p id="statusMessage" class="status-message"></p>
      </div>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    background-color: #f5f5f5;
    color: #333;
    line-height: 1.6;
  }

  main {
    max-width: 500px;
    margin: 0 auto;
    padding: 2rem;
  }

  .token-form {
    background: white;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  h2 {
    margin-bottom: 0.5rem;
    color: #2d5a27;
  }

  .description {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .input-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  input {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 2px solid #ddd;
    border-radius: 8px;
    transition: border-color 0.2s;
  }

  input:focus {
    outline: none;
    border-color: #4a8c3f;
  }

  button {
    width: 100%;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: white;
    background-color: #4a8c3f;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  button:hover {
    background-color: #3d7434;
  }

  button:active {
    background-color: #2d5a27;
  }

  .status-message {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9rem;
    min-height: 1.4em;
  }

  .status-message.success {
    color: #2d7a2d;
  }

  .status-message.error {
    color: #c53030;
  }

  @media (max-width: 600px) {
    main {
      padding: 1rem;
    }

    .token-form {
      padding: 1.5rem;
    }
  }
</style>

<script>
  const tokenInput = document.getElementById('tokenInput') as HTMLInputElement;
  const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;
  const statusMessage = document.getElementById(
    'statusMessage',
  ) as HTMLParagraphElement;

  saveBtn.addEventListener('click', () => {
    const token = tokenInput.value.trim();

    if (!token) {
      statusMessage.textContent = 'Inserisci un token valido';
      statusMessage.className = 'status-message error';
      return;
    }

    try {
      localStorage.setItem('gh_token', token);
      statusMessage.textContent = 'Token salvato! Reindirizzamento...';
      statusMessage.className = 'status-message success';

      setTimeout(() => {
        window.location.href = '/admin';
      }, 500);
    } catch (error) {
      statusMessage.textContent = 'Errore nel salvataggio del token';
      statusMessage.className = 'status-message error';
    }
  });

  // Allow pressing Enter to save
  tokenInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      saveBtn.click();
    }
  });
</script>
