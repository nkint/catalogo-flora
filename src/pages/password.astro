---
/**
 * Password Page
 * Saves GitHub token to localStorage for mobile image upload authentication.
 */

import Header from '../components/Header.astro';

const baseUrl = import.meta.env.BASE_URL;
const GITHUB_OWNER = 'nkint';
const GITHUB_REPO = 'catalogo-flora';
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="icon" href={`${baseUrl}/favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Token GitHub - Catalogo Flora</title>
  </head>

  <body>
    <Header title="Configurazione Token" />

    <main>
      <div class="token-form">
        <h2>Inserisci il Token GitHub</h2>
        <p class="description">
          Questo token viene salvato localmente sul dispositivo e serve per
          caricare le foto nel repository.
        </p>

        <div class="input-group">
          <label for="tokenInput">Token GitHub</label>
          <div class="input-wrapper">
            <input
              type="password"
              id="tokenInput"
              placeholder="ghp_xxxxxxxxxxxx"
              autocomplete="off"
            />
            <button
              type="button"
              id="toggleVisibility"
              class="toggle-btn"
              aria-label="Mostra/nascondi token"
            >
              👁
            </button>
          </div>
        </div>

        <button id="saveBtn" type="button">Salva</button>

        <p id="statusMessage" class="status-message"></p>
      </div>
    </main>

    <script
      id="config"
      type="application/json"
      set:html={JSON.stringify({ baseUrl })}
    />

    <!-- Debug Panel -->
    <details class="debug-panel">
      <summary>Debug Info</summary>
      <div class="debug-content">
        <p><strong>GITHUB_OWNER:</strong> <code>{GITHUB_OWNER}</code></p>
        <p><strong>GITHUB_REPO:</strong> <code>{GITHUB_REPO}</code></p>
        <p><strong>Base URL:</strong> <code>{baseUrl}</code></p>
        <p><strong>Redirect URL:</strong> <code>{baseUrl}/admin</code></p>
        <p>
          <strong>Token salvato:</strong>
          <span id="debugTokenStatus">checking...</span>
        </p>
        <p>
          <strong>Token (masked):</strong>
          <span id="debugTokenValue">-</span>
        </p>
      </div>
    </details>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    background-color: #f5f5f5;
    color: #333;
    line-height: 1.6;
  }

  main {
    max-width: 500px;
    margin: 0 auto;
    padding: 2rem;
  }

  .token-form {
    background: white;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  h2 {
    margin-bottom: 0.5rem;
    color: #2d5a27;
  }

  .description {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .input-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .input-wrapper {
    position: relative;
    display: flex;
  }

  input {
    width: 100%;
    padding: 0.75rem 1rem;
    padding-right: 3rem;
    font-size: 1rem;
    border: 2px solid #ddd;
    border-radius: 8px;
    transition: border-color 0.2s;
  }

  input:focus {
    outline: none;
    border-color: #4a8c3f;
  }

  .toggle-btn {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0.25rem;
    opacity: 0.6;
    width: auto;
  }

  .toggle-btn:hover {
    opacity: 1;
    background: none;
  }

  button {
    width: 100%;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    color: white;
    background-color: #4a8c3f;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  button:hover {
    background-color: #3d7434;
  }

  button:active {
    background-color: #2d5a27;
  }

  .status-message {
    margin-top: 1rem;
    text-align: center;
    font-size: 0.9rem;
    min-height: 1.4em;
  }

  .status-message.success {
    color: #2d7a2d;
  }

  .status-message.error {
    color: #c53030;
  }

  .debug-panel {
    margin-top: 2rem;
    background: #fff3cd;
    border: 1px solid #ffc107;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
  }

  .debug-panel summary {
    cursor: pointer;
    font-weight: 600;
    color: #856404;
  }

  .debug-content {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #ffc107;
  }

  .debug-content p {
    margin: 0.25rem 0;
  }

  .debug-content code {
    background: #f8f9fa;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-family: monospace;
  }

  @media (max-width: 600px) {
    main {
      padding: 1rem;
    }

    .token-form {
      padding: 1.5rem;
    }
  }
</style>

<script>
  const configEl = document.getElementById('config');
  const config = configEl ? JSON.parse(configEl.textContent || '{}') : {};
  const baseUrl = config.baseUrl || '';

  // Debug panel updates
  const debugTokenStatus = document.getElementById('debugTokenStatus');
  const debugTokenValue = document.getElementById('debugTokenValue');

  function updateDebugPanel() {
    const token = localStorage.getItem('gh_token');
    if (debugTokenStatus) {
      debugTokenStatus.textContent = token ? 'Si' : 'No';
      debugTokenStatus.style.color = token ? 'green' : 'red';
    }
    if (debugTokenValue && token) {
      const masked =
        token.length > 8 ? `${token.slice(0, 4)}...${token.slice(-4)}` : '****';
      debugTokenValue.textContent = masked;
    }
  }
  updateDebugPanel();

  const tokenInput = document.getElementById('tokenInput') as HTMLInputElement;
  const saveBtn = document.getElementById('saveBtn') as HTMLButtonElement;
  const statusMessage = document.getElementById(
    'statusMessage',
  ) as HTMLParagraphElement;
  const toggleBtn = document.getElementById(
    'toggleVisibility',
  ) as HTMLButtonElement;

  // Toggle password visibility
  toggleBtn.addEventListener('click', () => {
    if (tokenInput.type === 'password') {
      tokenInput.type = 'text';
      toggleBtn.textContent = '🙈';
    } else {
      tokenInput.type = 'password';
      toggleBtn.textContent = '👁';
    }
  });

  saveBtn.addEventListener('click', () => {
    const token = tokenInput.value.trim();

    if (!token) {
      statusMessage.textContent = 'Inserisci un token valido';
      statusMessage.className = 'status-message error';
      return;
    }

    try {
      localStorage.setItem('gh_token', token);
      statusMessage.textContent = 'Token salvato! Reindirizzamento...';
      statusMessage.className = 'status-message success';

      const redirectUrl = `${baseUrl}/admin`;
      setTimeout(() => {
        window.location.href = redirectUrl;
      }, 500);
    } catch (error) {
      statusMessage.textContent = 'Errore nel salvataggio del token';
      statusMessage.className = 'status-message error';
    }
  });

  // Allow pressing Enter to save
  tokenInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      saveBtn.click();
    }
  });
</script>
