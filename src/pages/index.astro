---
/**
 * Product Catalog Page
 * Fetches product data from a public Google Sheet and renders grouped product listings.
 */

import Header from '../components/Header.astro';
import SpeciesAccordion from '../components/SpeciesAccordion.astro';
import RawDataModal from '../components/RawDataModal.astro';
import ImageModal from '../components/ImageModal.astro';
import { fetchProducts, type Product } from '../lib/products';

const SHEET_ID = '1Yk68VFgmELY-VCImW_rAPUNru7CuYq4m_buYLXUKn8Q';

const products: Product[] = await fetchProducts(
  SHEET_ID,
  import.meta.env.BASE_URL,
);

// Extract species prefix from code (alphabetic part before numbers)
function getSpeciesPrefix(code: string): string {
  const match = code.match(/^[a-zA-Z]+/);
  return match ? match[0].toLowerCase() : code;
}

// Group products by species prefix
const groupedProducts = products.reduce(
  (acc, product) => {
    const prefix = getSpeciesPrefix(product.code);
    if (!acc[prefix]) {
      acc[prefix] = [];
    }
    acc[prefix].push(product);
    return acc;
  },
  {} as Record<string, Product[]>,
);

// Get sorted group keys
const groupKeys = Object.keys(groupedProducts).sort();
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Catalogo Flora</title>
  </head>

  <body>
    <Header title="Catalogo Flora" />

    <main>
      {
        products.length === 0 ? (
          <p class="empty-message">Nessun prodotto disponibile.</p>
        ) : (
          <div class="product-groups">
            {groupKeys.map((prefix) => (
              <SpeciesAccordion
                speciesCode={prefix}
                products={groupedProducts[prefix]}
                baseUrl={import.meta.env.BASE_URL}
              />
            ))}
          </div>
        )
      }
    </main>

    <RawDataModal />
    <ImageModal />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    background-color: #f5f5f5;
    color: #333;
    line-height: 1.6;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .empty-message {
    text-align: center;
    color: #666;
    font-size: 1.2rem;
    padding: 3rem;
  }

  .product-groups {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (max-width: 600px) {
    main {
      padding: 1rem;
    }
  }
</style>
